# ★このファイルを自分の環境に合わせて書き換えてから scripts/install.sh を実行する★
#
#   ls -l /dev/disk/by-id/ | grep -v part
#
# 必ず by-id を使うこと。/dev/sda などのバス依存名はブート順で入れ替わる。

SSD=/dev/disk/by-id/nvme-Samsung_SSD_990_PRO_1TB_S7HDNJ0Y914245A
HDD1=/dev/disk/by-id/ata-ST4000DM004-2U9104_WW638RJX
HDD2=/dev/disk/by-id/ata-ST4000DM004-2U9104_WW63DE1H

# --- パーティションサイズ ---
# rpool (システム用プール) は残り全部を取るのでサイズ指定はありません。
#   例) 477 GiB の SSD で 1 + 16 + 8 = 25 GiB -> rpool 約 452 GiB
EFI_SIZE=1G      # /boot
SWAP_SIZE=16G    # 生パーティション swap (randomEncryption)。ハイバネートしないなら 16G で十分
SLOG_SIZE=8G     # dpool の SLOG 用に確保だけしておく (既定では未使用)

# --- ZFS ---
ASHIFT=12        # 物理セクタ 4096 -> 12 / 16384 -> 14。作成後は変更不可。

# SLOG を実際に有効化するか。1 で dpool に log vdev を追加する。
# 同期書き込み (NFS サーバ / DB) にしか効かないのでデスクトップ用途では 0 のまま。
USE_SLOG=0

# ZFS ARC の上限 (バイト)。実 RAM の 1/4〜1/2 を目安に。
# 8G=8589934592 12G=12884901888 16G=17179869184 32G=34359738368
ARC_MAX_BYTES=17179869184

# --- /nix をどちらのプールに置くか ---
#   rpool = SSD (推奨。リビルド/GC が速い)
#   dpool = HDD (SSD の書き込みを節約したい場合のみ。ビルド/GC は HDD 速度)
NIX_POOL=rpool

# --- システム設定 ---
HOSTNAME=seita-nix-baremetal
USER_NAME=seita
USER_DESCRIPTION=seita

# --- ネットワーク -------------------------------------------------------
# 静的 IP (CIDR 表記)。空にすると DHCP + NetworkManager になります。
STATIC_ADDRESS=192.168.11.254/24
GATEWAY=192.168.11.1

# DNS。空白区切りで複数指定可。ルータに任せるならゲートウェイと同じで可。
NAMESERVERS="192.168.11.1"

# 静的 IP を割り当てるインタフェース (systemd-networkd の Match Name)。
# 有線1本なら en* のままで通ります。複数 NIC がある場合は
#   ip -br link
# で名前を確認して固定してください (例: enp3s0)。
NETWORK_INTERFACE="en*"

# hostId (8 桁 16 進数)。空なら install.sh が ISO の /etc/machine-id から生成する。
HOST_ID=

# --- 認証 ---------------------------------------------------------------
# ログイン手段は次の3つ。少なくとも1つは有効にすること。
#
#   1) PROMPT_ROOT_PASSWORD=1
#        nixos-install の最後に root パスワードを対話設定する。
#        /etc/shadow に直接書かれ Nix ストアに残らないので、これが既定かつ推奨。
#        コンソールログインと sudo に使える。
#   2) SSH_AUTHORIZED_KEYS
#        SSH でログインできる。configuration.nix は
#        PasswordAuthentication = false なので、SSH で入るにはこれが必須。
#   3) USER_PASSWORD_HASH / ROOT_PASSWORD_HASH
#        宣言的に固定したい場合のみ。Nix ストアに残る点に注意 (下記参照)。
#
# 1 だけでも締め出しにはならない (コンソールで root ログイン -> passwd <user>)。
# SSH で運用するなら 2 も入れておくこと。

# 再起動後に SSH で入るための公開鍵。
# 空の場合、install.sh が ISO 上の /root/.ssh/authorized_keys を自動で引き継ぐ。
# ISO にコンソールで入っている場合は鍵が無いので、ここに手で貼ること。
#   作業マシンで:  cat ~/.ssh/id_ed25519.pub
#   鍵が無ければ:  ssh-keygen -t ed25519
# 複数指定する場合は改行区切り。
SSH_AUTHORIZED_KEYS=''

# SSH のパスワード認証を許可するか。
#   0 (推奨) = 公開鍵のみ。SSH_AUTHORIZED_KEYS が空だと SSH では入れません
#              ("Permission denied (publickey,keyboard-interactive)")。
#              passwd で設定したパスワードはコンソールと sudo にしか効きません。
#   1        = パスワードでも SSH ログインできる。鍵をまだ用意していない場合や
#              LAN 内だけで使う場合はこちら。root の直接ログインは 1 でも不可。
ALLOW_PASSWORD_AUTH=1

# root パスワードを nixos-install の最後に対話で設定するか。
#   1 (推奨) = 対話で設定する。
#              入力値は /mnt/etc/shadow に直接書かれ、Nix ストアには残らない。
#              users.mutableUsers は既定の true なので、以後のリビルドでも消えない。
#              通常ユーザーのパスワードは初回起動後に  passwd <user>  で設定する。
#   0        = 対話しない。下の *_PASSWORD_HASH か SSH 鍵でログイン手段を用意すること。
PROMPT_ROOT_PASSWORD=1

# パスワードハッシュ (任意)。ISO 上で生成:
#   nix-shell -p mkpasswd --run 'mkpasswd -m yescrypt'
#
# ここに書いた値は machine.nix 経由で configuration.nix に埋め込まれ、
# world-readable な /nix/store に残ります。オフラインで解析されうるので、
# 通常は空のままにして PROMPT_ROOT_PASSWORD=1 + passwd を使ってください。
#
# ★書く場合は必ずシングルクォートで囲むこと★
#   ハッシュには $ が含まれるため、ダブルクォートだと bash が変数展開して壊します。
#     OK : USER_PASSWORD_HASH='$y$j9T$abc...'
#     NG : USER_PASSWORD_HASH="$y$j9T$abc..."
USER_PASSWORD_HASH=''
ROOT_PASSWORD_HASH=''
