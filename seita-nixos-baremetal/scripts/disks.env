# ★Edit this file for your environment before running scripts/install.sh★
#
#   ls -l /dev/disk/by-id/ | grep -v part
#
# Always use by-id. Bus-dependent names like /dev/sda can change across boots.

SSD=/dev/disk/by-id/nvme-Samsung_SSD_990_PRO_1TB_S7HDNJ0Y914245A
HDD1=/dev/disk/by-id/ata-ST4000DM004-2U9104_WW638RJX
HDD2=/dev/disk/by-id/ata-ST4000DM004-2U9104_WW63DE1H

# --- Partition sizes ---
# rpool (the system pool) takes whatever is left, so it has no size setting.
#   e.g. on a 477 GiB SSD, 1 + 16 + 8 = 25 GiB -> rpool gets about 452 GiB
EFI_SIZE=1G      # /boot
SWAP_SIZE=16G    # raw swap partition (randomEncryption). 16G is enough if you don't hibernate
SLOG_SIZE=8G     # reserved for dpool's SLOG (unused by default)

# --- ZFS ---
ASHIFT=12        # physical sector 4096 -> 12 / 16384 -> 14. Cannot change after creation.

# Whether to actually enable the SLOG. 1 adds a log vdev to dpool.
# Only affects sync writes (NFS server / DB), so leave it 0 for desktop use.
USE_SLOG=0

# ZFS ARC limit (bytes). Rule of thumb: 1/4 to 1/2 of physical RAM.
# 8G=8589934592 12G=12884901888 16G=17179869184 32G=34359738368
ARC_MAX_BYTES=17179869184

# --- Which pool /nix lives on ---
#   rpool = SSD (recommended. Rebuilds/GC are fast)
#   dpool = HDD (only if you want to save SSD writes. Build/GC run at HDD speed)
NIX_POOL=rpool

# --- System settings ---
HOSTNAME=seita-nixos-baremetal
USER_NAME=seita
USER_DESCRIPTION=seita

# --- Network ---------------------------------------------------------------
# Static IP (CIDR notation). Leave empty for DHCP + NetworkManager.
STATIC_ADDRESS=192.168.11.254/24
GATEWAY=192.168.11.1

# DNS. Space-separated for multiple. Fine to match the gateway if you defer to the router.
NAMESERVERS="192.168.11.1"

# Interface to assign the static IP to (systemd-networkd Match Name).
# "en*" works for a single wired NIC. With multiple NICs, check the name with
#   ip -br link
# and pin it explicitly (e.g. enp3s0).
NETWORK_INTERFACE="en*"

# hostId (8-digit hex). If empty, install.sh generates it from the ISO's /etc/machine-id.
HOST_ID=

# --- Authentication ---------------------------------------------------------
# There are three login methods below. Enable at least one.
#
#   1) PROMPT_ROOT_PASSWORD=1
#        Sets the root password interactively at the end of nixos-install.
#        Written directly to /etc/shadow, not kept in the Nix store — this is
#        the default and recommended option.
#        Usable for console login and sudo.
#   2) SSH_AUTHORIZED_KEYS
#        Lets you log in over SSH. configuration.nix has
#        PasswordAuthentication = false, so this is required for SSH access.
#   3) USER_PASSWORD_HASH / ROOT_PASSWORD_HASH
#        Only if you want this fixed declaratively. Note: this stays in the
#        Nix store (see below).
#
# 1 alone doesn't lock you out (console root login -> passwd <user>).
# If you'll operate over SSH, also set up 2.

# Public key(s) for SSH access after reboot.
# If empty, install.sh automatically carries over /root/.ssh/authorized_keys
# from the ISO. If you're on the ISO via console, there's no such key, so
# paste one here manually.
#   On your workstation:  cat ~/.ssh/id_ed25519.pub
#   If you don't have one:  ssh-keygen -t ed25519
# Newline-separated for multiple keys.
SSH_AUTHORIZED_KEYS=''

# Whether to allow SSH password authentication.
#   0 (recommended) = public key only. If SSH_AUTHORIZED_KEYS is empty, SSH
#              access is impossible
#              ("Permission denied (publickey,keyboard-interactive)").
#              The password set via passwd only works for console and sudo.
#   1        = also allow password-based SSH login. Use this if you don't have
#              a key ready yet, or if this is LAN-only. Direct root login is
#              still disallowed even with 1.
ALLOW_PASSWORD_AUTH=1

# Whether to set the root password interactively at the end of nixos-install.
#   1 (recommended) = set it interactively.
#              The value is written directly to /mnt/etc/shadow, not kept in
#              the Nix store.
#              users.mutableUsers defaults to true, so it survives later
#              rebuilds.
#              Set the regular user's password after first boot with
#              passwd <user>.
#   0        = don't prompt. Make sure a login method is set up via the
#              *_PASSWORD_HASH settings below or an SSH key.
PROMPT_ROOT_PASSWORD=1

# Password hash (optional). Generate on the ISO with:
#   nix-shell -p mkpasswd --run 'mkpasswd -m yescrypt'
#
# A value set here gets embedded via machine.nix into configuration.nix and
# ends up in the world-readable /nix/store, where it could be extracted
# offline. Normally leave this empty and use PROMPT_ROOT_PASSWORD=1 + passwd
# instead.
#
# ★If you do set this, always wrap it in single quotes★
#   The hash contains $, which bash would expand under double quotes and corrupt.
#     OK : USER_PASSWORD_HASH='$y$j9T$abc...'
#     NG : USER_PASSWORD_HASH="$y$j9T$abc..."
USER_PASSWORD_HASH=''
ROOT_PASSWORD_HASH=''
